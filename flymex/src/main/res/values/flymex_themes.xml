    <style name="ThemeOverlay.Flymex.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/mz_dialog_background_drawable</item>
        <item name="android:windowAnimationStyle">@style/Animation.Flymex.Dialog</item>
        <item name="android:windowMinWidthMajor">@dimen/mz_alert_dialog_width</item>
        <item name="android:windowMinWidthMinor">@dimen/mz_alert_dialog_width</item>
        <item name="android:backgroundDimAmount">0.1</item>
