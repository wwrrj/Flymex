<?xml version="1.0" encoding="utf-8"?>
<!-- Port of Flyme's layout/mc_toast_layout.xml (complete toast): Widget.Flyme.Shadow.Large card,
     min width mz_complete_toast_width (144dp), 24/16dp padding, 30dp check icon, 14sp medium text
     wrapped at mz_complete_toast_text_width (112dp). -->
<com.flymex.widget.FlymeCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/mz_complete_toast_width"
    app:mzCornerRadius="@dimen/fd_sys_radius_corner_smooth_medium"
    app:mzShadowLevel="large">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/mz_complete_toast_text_margin_horizontal"
        android:paddingTop="@dimen/mz_complete_toast_background_padding"
        android:paddingEnd="@dimen/mz_complete_toast_text_margin_horizontal"
        android:paddingBottom="@dimen/mz_complete_toast_background_padding">

        <FrameLayout
            android:id="@+id/flymex_toast_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="@dimen/mz_complete_toast_icon_margin_bottom"
            android:background="@drawable/flymex_circle_primary">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/mz_vec_btn_checked_true_normal"
                app:tint="?attr/colorOnPrimary" />
        </FrameLayout>

        <TextView
            android:id="@+id/flymex_toast_text"
            android:layout_width="@dimen/mz_complete_toast_text_width"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />
    </LinearLayout>
</com.flymex.widget.FlymeCardView>
